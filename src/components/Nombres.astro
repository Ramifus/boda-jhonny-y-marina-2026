<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (typeof window !== 'undefined') {
    document.addEventListener("DOMContentLoaded", () => {
      console.log("👨‍👩‍👧‍👦 Iniciando animaciones de padres...");

      // 🎯 ESTADO INICIAL - Todo oculto
      gsap.set("#separador-bendicion", { opacity: 0, y: -16, scale: 0.96 });
      gsap.set("#texto-bendicion", { opacity: 0, y: 22, scale: 0.97 });
      gsap.set("#seccion-padres-novio", { opacity: 0, y: 22 });
      gsap.set("#seccion-padres-novia", { opacity: 0, y: 22 });
      gsap.set(".seccion-padrinos", { opacity: 0, y: 22 });
      gsap.set(".adorno-izq", { opacity: 0, x: -22 });
      gsap.set(".adorno-der", { opacity: 0, x: 22 });

      // 📍 SCROLLTRIGGER PARA ACTIVAR LA ANIMACIÓN
      ScrollTrigger.create({
        trigger: "#texto-bendicion",
        start: "top 90%",
        end: "top 20%",
        
        onEnter: () => {
          console.log("✨ Padres y padrinos apareciendo simultáneamente...");
          animarSimultaneo();
        },
        
        onLeaveBack: () => {
          console.log("👋 Ocultando sección de padres...");
          ocultarSimultaneo();
        },
      });

      // 🎬 ANIMACIÓN SIMULTÁNEA - TODO AL MISMO TIEMPO
      function animarSimultaneo() {
        // Animación elegante del texto de bendición (fade + scale suave)
        gsap.to("#texto-bendicion", {
          delay: 0.1,
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 1.6,
          ease: "power3.out",
        });
        
        const tl = gsap.timeline({ delay: 0.6 }); // Delay para que el texto aparezca primero

        // TODO aparece al mismo tiempo con la misma duración
        tl.to("#separador-bendicion, .adorno-izq, .adorno-der, #seccion-padres-novio, #seccion-padres-novia, .seccion-padrinos", {
          opacity: 1,
          duration: 1.4,
          ease: "power2.out",
            stagger: 0.12,
          })
        // Movimientos individuales (simultáneos)
        .to(".adorno-izq", {
          x: 0,
          duration: 1.4,
          ease: "power2.out",
        }, "<0.12")
        .to(".adorno-der", {
          x: 0,
          duration: 1.4,
          ease: "power2.out",
        }, "<0.12")
        .to("#seccion-padres-novio, #seccion-padres-novia, .seccion-padrinos", {
          y: 0,
          duration: 1.4,
          ease: "power2.out",
        }, "<0.12");
      }

      // 🔙 ANIMACIÓN DE SALIDA SIMULTÁNEA
      function ocultarSimultaneo() {
        const tl = gsap.timeline();

        // TODO desaparece al mismo tiempo
        tl.to("#separador-bendicion, #texto-bendicion, .adorno-izq, .adorno-der, #seccion-padres-novio, #seccion-padres-novia, .seccion-padrinos", {
          opacity: 0,
          duration: 0.7,
          ease: "power2.in",
        })
        // Movimientos individuales (simultáneos)
        .to(".adorno-izq", {
          x: -22,
          duration: 0.7,
          ease: "power2.in",
        }, "<0.12")
        .to(".adorno-der", {
          x: 22,
          duration: 0.7,
          ease: "power2.in",
        }, "<0.12")
        .to("#separador-bendicion, #texto-bendicion, #seccion-padres-novio, #seccion-padres-novia, .seccion-padrinos", {
          y: 22,
          duration: 0.7,
          ease: "power2.in",
        }, "<0.12")
        .to("#texto-bendicion", {
          scale: 0.97,
          duration: 0.7,
          ease: "power2.in",
        }, "<0.12");
      }
    });
  }
</script>

